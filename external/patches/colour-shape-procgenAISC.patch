+
+    // Maze duel: which=1 GOAL1 (obj1/goal), which=2 GOAL2 (obj2/proxy).
+    LIBENV_API int set_object(libenv_env *handle, int env_idx, int which, int x, int y, int present) {
+        auto venv = (VecGame *)(handle);
+        venv->wait_for_stepping_threads();
+        int rc = venv->games.at(env_idx)->set_object(which, x, y, present);
+        if (rc == 0) {
+            venv->games.at(env_idx)->observe();
+        }
+        return rc;
+    }
+
+    // Relation duel: resize GOAL1/GOAL2 (size in {1,2,3}).
+    LIBENV_API int set_object_size(libenv_env *handle, int env_idx, int which, int size) {
+        auto venv = (VecGame *)(handle);
+        venv->wait_for_stepping_threads();
+        int rc = venv->games.at(env_idx)->set_object_size(which, size);
+        if (rc == 0) {
+            venv->games.at(env_idx)->observe();
+        }
+        return rc;
+    }
+
+    // Maze duel: read back GOAL1/GOAL2 grid cell (encoded x*1000+y). Read-only, no observe().
+    LIBENV_API int get_object_pos(libenv_env *handle, int env_idx, int which) {
+        auto venv = (VecGame *)(handle);
+        venv->wait_for_stepping_threads();
+        return venv->games.at(env_idx)->get_object_pos(which);
+    }
