diff --git a/procgen/env.py b/procgen/env.py
index be336a3..36509d6 100644
--- a/procgen/env.py
+++ b/procgen/env.py
@@ -163,6 +163,9 @@ class BaseProcgenEnv(CEnv):
             c_func_defs=[
                 "int get_state(libenv_env *, int, char *, int);",
                 "void set_state(libenv_env *, int, char *, int);",
+                "int set_object(libenv_env *, int, int, int, int, int);",
+                "int set_object_size(libenv_env *, int, int, int);",
+                "int get_object_pos(libenv_env *, int, int);",
             ],
         )
         # don't use the dict space for actions
@@ -183,6 +186,74 @@ class BaseProcgenEnv(CEnv):
             state = states[env_idx]
             self.call_c_func("set_state", env_idx, state, len(state))
 
+    def set_object(self, whichs, xs, ys, presents):
+        """Remove or place GOAL1/GOAL2 on maze_colorsobjects_duel / maze_relation_duel.
+
+        ``whichs[i]`` is 1 (obj1 / GOAL1) or 2 (obj2 / GOAL2).
+        ``presents[i]==0`` removes that object type; ``1`` places at ``(xs[i], ys[i])``.
+        Returns status codes per env (0 ok, -1 unsupported, -2 invalid).
+        """
+        assert (
+            len(whichs) == self.num
+            and len(xs) == self.num
+            and len(ys) == self.num
+            and len(presents) == self.num
+        )
+        out = []
+        for env_idx in range(self.num):
+            rc = self.call_c_func(
+                "set_object",
+                env_idx,
+                int(whichs[env_idx]),
+                int(xs[env_idx]),
+                int(ys[env_idx]),
+                int(presents[env_idx]),
+            )
+            out.append(int(rc))
+        return out
+
+    def set_object_size(self, whichs, sizes):
+        """Set discrete size level for GOAL1/GOAL2 on maze_relation_duel.
+
+        ``whichs[i]`` is 1 (obj1 / GOAL1) or 2 (obj2 / GOAL2).
+        ``sizes[i]`` is in {1, 2, 3} (scale 1.0 / 1.75 / 2.25).
+        Returns status codes per env (0 ok, -1 unsupported, -2 invalid).
+        """
+        assert len(whichs) == self.num and len(sizes) == self.num
+        out = []
+        for env_idx in range(self.num):
+            rc = self.call_c_func(
+                "set_object_size",
+                env_idx,
+                int(whichs[env_idx]),
+                int(sizes[env_idx]),
+            )
+            out.append(int(rc))
+        return out
+
