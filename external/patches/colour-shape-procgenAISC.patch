+            return -2;
+        }
+        int cur = get_obj(x, y);
+        if (cur == WALL_OBJ || cur == GOAL1 || cur == GOAL2) {
+            return -2;
+        }
+        set_obj(x, y, target);
+        return 0;
+    }
