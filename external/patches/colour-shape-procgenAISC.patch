diff --git a/procgen/build.py b/procgen/build.py
index ebe1ddd..4c4de95 100644
--- a/procgen/build.py
+++ b/procgen/build.py
@@ -100,6 +100,20 @@ def build(package=False, debug=False):
     if debug:
         build_type = "debug"
 
+    # Reuse an existing libenv when present (avoids -march=native / apple-m1 rebuild
+    # failures on Apple Silicon). Set PROCGEN_FORCE_REBUILD=1 to rebuild.
+    lib_name = "libenv.dll" if platform.system() == "Windows" else (
+        "libenv.dylib" if platform.system() == "Darwin" else "libenv.so"
+    )
+    existing_lib = os.path.join(build_dir, build_type, lib_name)
+    if (
+        not package
+        and os.environ.get("PROCGEN_FORCE_REBUILD") != "1"
+        and os.path.isfile(existing_lib)
+    ):
+        global_builds.add(build_type)
+        return os.path.join(build_dir, build_type)
+
     with chdir(build_dir), global_build_lock:
         # check if we have built yet in this process
         if build_type not in global_builds:
