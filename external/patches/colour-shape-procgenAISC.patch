diff --git a/procgen/src/games/maze_relation_duel.cpp b/procgen/src/games/maze_relation_duel.cpp
new file mode 100644
index 0000000..246fc2b
--- /dev/null
+++ b/procgen/src/games/maze_relation_duel.cpp
@@ -0,0 +1,333 @@
+#include "../basic-abstract-game.h"
+#include "../mazegen.h"
+#include <cmath>
+
+const std::string NAME = "maze_relation_duel";
+
+const float REWARD1 = 10.0;
+const float REWARD2 = -10.0;
+
+const int GOAL1 = 2;
+const int GOAL2 = 3;
+
+// relation_mode: 0 = larger (T always larger), 1 = nearer (sizes equal, T always nearer)
+const int RELATION_LARGER = 0;
+const int RELATION_NEARER = 1;
+
+class MazeRelationDuel : public BasicAbstractGame {
+  public:
+    std::shared_ptr<MazeGen> maze_gen_aisc;
+    int maze_dim = 0;
+    int world_dim = 0;
+    int goal1_size = 1;  // discrete size level in {1,2,3}
+    int goal2_size = 1;
+    int goal1_x = 0;
+    int goal1_y = 0;
+    int goal2_x = 0;
+    int goal2_y = 0;
+
+    MazeRelationDuel()
+        : BasicAbstractGame(NAME) {
+        timeout = 500;
+        random_agent_start = false;
+        has_useful_vel_info = false;
+
+        out_of_bounds_object = WALL_OBJ;
+        visibility = 8.0;
+    }
+
+    static float size_to_scale(int size) {
+        if (size <= 1)
+            return 1.0f;
+        if (size == 2)
+            return 1.75f;
+        return 2.25f;  // size >= 3
+    }
+
+    void load_background_images() override {
+        main_bg_images_ptr = &topdown_backgrounds;
+    }
+
+    void asset_for_type(int type, std::vector<std::string> &names) override {
+        if (type == WALL_OBJ) {
+            names.push_back("kenney/Ground/Sand/sandCenter.png");
+        } else if (type == GOAL1) {
+            names.push_back("kenney/Items/pure_" + options.obj1 + ".png");
+        } else if (type == GOAL2) {
+            names.push_back("kenney/Items/pure_" + options.obj2 + ".png");
+        } else if (type == PLAYER) {
+            names.push_back("kenney/Enemies/mouse_move.png");
+        }
+    }
+
+    QRectF get_adjusted_image_rect(int type, const QRectF &rect) override {
+        float s = 1.0f;
+        if (type == GOAL1) {
+            s = size_to_scale(goal1_size);
+        } else if (type == GOAL2) {
+            s = size_to_scale(goal2_size);
+        } else {
+            return rect;
+        }
+        if (s <= 1.0f + 1e-6f) {
+            return rect;
+        }
+        float cx = rect.x() + rect.width() * 0.5f;
+        float cy = rect.y() + rect.height() * 0.5f;
+        float w = rect.width() * s;
+        float h = rect.height() * s;
+        return QRectF(cx - w * 0.5f, cy - h * 0.5f, w, h);
+    }
+
+    void choose_world_dim() override {
+        int dist_diff = options.distribution_mode;
+
+        if (dist_diff == EasyMode) {
+            world_dim = options.world_dim;
+        } else if (dist_diff == HardMode) {
+            world_dim = 25;
+        } else if (dist_diff == MemoryMode) {
+            world_dim = 31;
+        }
+
+        main_width = world_dim;
+        main_height = world_dim;
+    }
+
+    void find_object(int target, int *ox, int *oy) {
+        *ox = -1;
+        *oy = -1;
+        for (int ix = 0; ix < main_width; ix++) {
+            for (int iy = 0; iy < main_height; iy++) {
+                if (get_obj(ix, iy) == target) {
+                    *ox = ix;
+                    *oy = iy;
+                    return;
+                }
+            }
+        }
+    }
+
+    float euclid_to_agent(int x, int y) {
+        float ax = agent->x;
+        float ay = agent->y;
+        float dx = (x + 0.5f) - ax;
+        float dy = (y + 0.5f) - ay;
+        return sqrtf(dx * dx + dy * dy);
+    }
+
+    void swap_goal_cells() {
+        if (goal1_x < 0 || goal2_x < 0) {
+            return;
+        }
+        set_obj(goal1_x, goal1_y, GOAL2);
+        set_obj(goal2_x, goal2_y, GOAL1);
+        int tx = goal1_x, ty = goal1_y;
+        goal1_x = goal2_x;
+        goal1_y = goal2_y;
+        goal2_x = tx;
+        goal2_y = ty;
+    }
+
+    void apply_relation_regime() {
+        find_object(GOAL1, &goal1_x, &goal1_y);
+        find_object(GOAL2, &goal2_x, &goal2_y);
+        if (goal1_x < 0 || goal2_x < 0) {
+            return;
+        }
+
+        int mode = options.relation_mode;
+        if (mode == RELATION_NEARER) {
+            goal1_size = 1;
+            goal2_size = 1;
+            float d1 = euclid_to_agent(goal1_x, goal1_y);
+            float d2 = euclid_to_agent(goal2_x, goal2_y);
+            // T (GOAL1) must be nearer. Swap cells if not.
+            if (d1 > d2 + 1e-4f) {
+                swap_goal_cells();
+            }
+        } else {
+            // RELATION_LARGER (default): T always larger. Sizes fixed; placement free.
+            goal1_size = 2;
+            goal2_size = 1;
+        }
+    }
+
+    void game_reset() override {
+        BasicAbstractGame::game_reset();
+
+        grid_step = true;
+
+        maze_dim = world_dim;
+        int margin = (world_dim - maze_dim) / 2;
+
+        std::shared_ptr<MazeGen> _maze_gen(new MazeGen(&rand_gen, maze_dim));
+        maze_gen_aisc = _maze_gen;
+
+        options.center_agent = options.distribution_mode == MemoryMode;
+
+        agent->rx = .5;
+        agent->ry = .5;
+        agent->x = margin + .5;
+        agent->y = margin + .5;
+
+        maze_gen_aisc->generate_maze_no_dead_ends();
+        maze_gen_aisc->place_objects(GOAL1, 1);
+        maze_gen_aisc->place_objects(GOAL2, 1);
+
+        for (int i = 0; i < grid_size; i++) {
+            set_obj(i, WALL_OBJ);
+        }
+
+        for (int i = 0; i < maze_dim; i++) {
+            for (int j = 0; j < maze_dim; j++) {
+                int type = maze_gen_aisc->grid.get(i + MAZE_OFFSET, j + MAZE_OFFSET);
+                set_obj(margin + i, margin + j, type);
+            }
+        }
+
+        if (margin > 0) {
+            for (int i = 0; i < maze_dim + 2; i++) {
+                set_obj(margin - 1, margin + i - 1, WALL_OBJ);
+                set_obj(margin + maze_dim, margin + i - 1, WALL_OBJ);
+
+                set_obj(margin + i - 1, margin - 1, WALL_OBJ);
+                set_obj(margin + i - 1, margin + maze_dim, WALL_OBJ);
+            }
+        }
+
+        apply_relation_regime();
+    }
+
+    void set_action_xy(int move_action) override {
+        BasicAbstractGame::set_action_xy(move_action);
+        if (action_vx != 0)
+            action_vy = 0;
+    }
+
+    void game_step() override {
+        BasicAbstractGame::game_step();
+
+        if (action_vx > 0)
+            agent->is_reflected = true;
+        if (action_vx < 0)
+            agent->is_reflected = false;
+
+        int ix = int(agent->x);
+        int iy = int(agent->y);
+
+        if (get_obj(ix, iy) == GOAL1) {
+            set_obj(ix, iy, SPACE);
+            step_data.reward += REWARD1;
+            step_data.level_complete = true;
+        }
+
+        if (get_obj(ix, iy) == GOAL2) {
+            set_obj(ix, iy, SPACE);
+            step_data.reward += REWARD2;
+            step_data.level_complete = true;
+        }
+
+        step_data.done = step_data.reward != 0;
+    }
+
+    void serialize(WriteBuffer *b) override {
+        BasicAbstractGame::serialize(b);
+        b->write_int(maze_dim);
+        b->write_int(world_dim);
+        b->write_int(goal1_size);
+        b->write_int(goal2_size);
+        b->write_int(goal1_x);
+        b->write_int(goal1_y);
+        b->write_int(goal2_x);
+        b->write_int(goal2_y);
+    }
+
+    void deserialize(ReadBuffer *b) override {
+        BasicAbstractGame::deserialize(b);
+        maze_dim = b->read_int();
+        world_dim = b->read_int();
+        goal1_size = b->read_int();
+        goal2_size = b->read_int();
+        goal1_x = b->read_int();
+        goal1_y = b->read_int();
+        goal2_x = b->read_int();
+        goal2_y = b->read_int();
+    }
+
+    int set_object(int which, int x, int y, int present) override {
+        int target = (which == 1) ? GOAL1 : ((which == 2) ? GOAL2 : 0);
+        if (target == 0) {
+            return -2;
+        }
+        for (int ix = 0; ix < main_width; ix++) {
+            for (int iy = 0; iy < main_height; iy++) {
+                if (get_obj(ix, iy) == target) {
+                    set_obj(ix, iy, SPACE);
+                }
+            }
+        }
+        if (which == 1) {
+            goal1_x = -1;
+            goal1_y = -1;
+        } else {
+            goal2_x = -1;
+            goal2_y = -1;
+        }
+        if (!present) {
+            return 0;
+        }
+        if (x < 0 || y < 0 || x >= main_width || y >= main_height) {
+            return -2;
+        }
+        int cur = get_obj(x, y);
+        if (cur == WALL_OBJ || cur == GOAL1 || cur == GOAL2) {
+            return -2;
+        }
+        set_obj(x, y, target);
+        if (which == 1) {
+            goal1_x = x;
+            goal1_y = y;
+        } else {
+            goal2_x = x;
+            goal2_y = y;
+        }
+        return 0;
+    }
+
+    // Read back GOAL1/GOAL2 grid cell. Positions are already tracked (kept current
+    // by set_object and swap_goal_cells), so this is O(1), no grid scan needed.
+    // Encoded x*1000+y; -2 for invalid `which` or absent object (see game.h).
+    int get_object_pos(int which) override {
+        if (which != 1 && which != 2) {
+            return -2;
+        }
+        if (main_width >= 1000 || main_height >= 1000) {
+            return -1;  // encoding cannot represent a grid this large
+        }
+        int gx = (which == 1) ? goal1_x : goal2_x;
+        int gy = (which == 1) ? goal1_y : goal2_y;
+        if (gx < 0 || gy < 0) {
+            return -2;
+        }
+        return gx * 1000 + gy;
+    }
+
+    // Discrete size levels {1,2,3}. which=1 GOAL1 / which=2 GOAL2.
+    int set_object_size(int which, int size) override {
+        if (size < 1 || size > 3) {
+            return -2;
+        }
+        if (which == 1) {
+            goal1_size = size;
+            return 0;
+        }
+        if (which == 2) {
+            goal2_size = size;
+            return 0;
+        }
+        return -2;
+    }
+};
+
+REGISTER_GAME(NAME, MazeRelationDuel);
