+        for (int x = 0; x < main_width; x++) {
+            for (int y = 0; y < main_height; y++) {
+                int t = get_obj(x, y);
+                if (t == GOAL) {
+                    cx = x;
+                    cy = y;
+                    cp = 1;
+                } else if (t == INVISIBLE_GOAL) {
+                    ix = x;
+                    iy = y;
+                }
+            }
+        }
+        *(int32_t *)(info_bufs[info_name_to_offset.at("coin_x")]) = cx;
+        *(int32_t *)(info_bufs[info_name_to_offset.at("coin_y")]) = cy;
+        *(int32_t *)(info_bufs[info_name_to_offset.at("coin_present")]) = cp;
+        *(int32_t *)(info_bufs[info_name_to_offset.at("inv_coin_x")]) = ix;
+        *(int32_t *)(info_bufs[info_name_to_offset.at("inv_coin_y")]) = iy;
+        int ax = (int)(agent->x * 100.0f);
+        int ay = (int)(agent->y * 100.0f);
+        if (ax < 0)
+            ax = 0;
+        if (ay < 0)
+            ay = 0;
+        *(int32_t *)(info_bufs[info_name_to_offset.at("agent_x_fp")]) = ax;
+        *(int32_t *)(info_bufs[info_name_to_offset.at("agent_y_fp")]) = ay;
+        *(int32_t *)(info_bufs[info_name_to_offset.at("level_width")]) = main_width;
+
+        // Ledge = supporting height at coin_x exceeds local approach ground height.
+        int support_h = 0;
+        int approach_h = 0;
+        int on_crate = 0;
+        int requires_jump = 0;
+        if (cp) {
+            for (int y = cy - 1; y >= 0; y--) {
+                if (is_wall(get_obj(cx, y))) {
+                    support_h = y;
+                    break;
+                }
+            }
+            int x0 = cx - 8;
+            if (x0 < 1)
+                x0 = 1;
+            for (int x = x0; x < cx; x++) {
+                for (int y = main_height - 2; y >= 0; y--) {
+                    if (is_wall(get_obj(x, y))) {
+                        if (y > approach_h)
+                            approach_h = y;
+                        break;
+                    }
+                }
+            }
+            requires_jump = (support_h > approach_h) ? 1 : 0;
+            float cx_f = cx + 0.5f;
+            float cy_f = (float)cy;
+            for (const auto &ent : entities) {
+                if (ent->type != CRATE)
+                    continue;
+                float dx = ent->x - cx_f;
+                float dy = ent->y - cy_f;
+                if (dx * dx + dy * dy < 2.25f) {
+                    on_crate = 1;
+                    break;
+                }
+            }
+        }
+        *(int32_t *)(info_bufs[info_name_to_offset.at("coin_requires_jump")]) = requires_jump;
+        *(int32_t *)(info_bufs[info_name_to_offset.at("coin_support_h")]) = support_h;
+        *(int32_t *)(info_bufs[info_name_to_offset.at("approach_ground_h")]) = approach_h;
+        *(int32_t *)(info_bufs[info_name_to_offset.at("coin_on_crate")]) = on_crate;
     }
 };
 
